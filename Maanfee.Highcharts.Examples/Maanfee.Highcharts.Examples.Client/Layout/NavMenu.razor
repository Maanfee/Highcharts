<MudPaper Width="250px" Class="d-inline-flex py-3" Elevation="0">
    <MudNavMenu Class="mud-width-full">
        <MudText Typo="Typo.h6" Class="px-4">Maanfee Highcharts</MudText>
        <MudDivider Class="my-2" />
        <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard">Home</MudNavLink>
        <MudNavGroup Title="Column and bar Charts" Icon="@Icons.Material.Filled.BarChart" Expanded="true">
            <MudNavLink Href="/BasicColumnView" IconColor="Color.Success">Basic Column</MudNavLink>
        </MudNavGroup>
        <MudNavGroup Title="Line Charts" Icon="@Icons.Material.Filled.ShowChart" Expanded="true">
            <MudNavLink Href="/LineWithDataLabelsView" IconColor="Color.Success">With data labels</MudNavLink>
        </MudNavGroup>
        <MudNavGroup Title="Pie Charts" Icon="@Icons.Material.Filled.PieChart" Expanded="true">
            <MudNavLink Href="/PieChartView" IconColor="Color.Success">Pie Chart</MudNavLink>
            <MudNavLink Href="/DonutChartView" IconColor="Color.Success">Donut Chart View</MudNavLink>
            <MudNavLink Href="/SemiCircleDonutView" IconColor="Color.Success">Semi Circle Donut Chart</MudNavLink>
        </MudNavGroup>
    </MudNavMenu>
</MudPaper>
